@startuml
!include _style.iuml
hide empty members
class AdoptionForm <<Livewire>> {
  +submit(SubmitAdoptionApplication)
  +updatedPhone()
}
class SubmitAdoptionApplication {
  +handle(Animal, array, ?User, ?string): AdoptionApplication
  +hasActiveDuplicate(Animal, string): bool
  -ownerId(string, ?User): ?int
  -notify(AdoptionApplication)
}
class ApplicationWorkflow {
  +transition(app, ApplicationStatus, User, ?string)
  +adopt(app, User, ?string)
  +closeForRemovedAnimal(Animal, User)
  +assertAllowed(from, to)
}
class ApplicationShow <<Livewire>> {
  +changeStatus(string)
  +saveNotes()
}
class PostBlocks {
  +validate(array): array
  +forRender(array): array
  +{static} types(): array<string, BlockType>
  +{static} localize(array, locale): array
  +{static} englishCoverage(array): array
}
interface BlockType {
  +key(): string
  +rules(): array
  +normalize(array): array
  +localize(array): array
  +forRender(array): ?array
}
interface PreparesBatch {
  +prepare(array)
}
abstract class AbstractBlock {
  #TEXT_FIELDS
  #LIST_FIELDS
}
class "HeadingBlock, ParagraphBlock,\nImageBlock, QuoteBlock, ListBlock" as TextBlocks
class AnimalBlock
class VideoBlock {
  +{static} parse(url): ?array
}
class PostEditor <<Livewire>>
class Dictionaries <<Livewire>>
class DictionaryType <<enum>> {
  Species, Breeds, Colors, Categories
  +model(): string
  +fields(): array
  +usageRelation(): string
}
class ApplicationStatus <<enum>> {
  New, InProgress, MeetingScheduled,
  Adopted, Declined, Closed
  +allowedTransitions(): list
  +canTransitionTo(target): bool
}
class AnimalStatus <<enum>>
class AgeGroup <<enum>> {
  +birthDateRange(today): array
}
class AnimalCatalog <<Livewire>>
class "Animal" as Animal <<Model>> {
  +scopeFilter(query, filters)
  +acceptsApplications(): bool
}
class AnimalPolicy <<Policy>>
class LinkApplicationsToVerifiedUser <<Listener>> {
  +handle(Verified)
}
AdoptionForm --> SubmitAdoptionApplication
ApplicationShow --> ApplicationWorkflow
ApplicationWorkflow --> ApplicationStatus
ApplicationWorkflow --> Animal
PostEditor --> PostBlocks
PostBlocks o--> "7" BlockType
AbstractBlock ..|> BlockType
TextBlocks --|> AbstractBlock
AnimalBlock --|> AbstractBlock
VideoBlock --|> AbstractBlock
AnimalBlock ..|> PreparesBatch
Dictionaries --> DictionaryType
AnimalCatalog --> Animal
Animal --> AgeGroup
Animal --> AnimalStatus
AnimalCatalog ..> AnimalPolicy
@enduml
