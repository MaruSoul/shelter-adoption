@startuml
!include _style.iuml
hide circle
skinparam linetype ortho
entity "species" as species {
  * id : bigint <<PK>>
  --
  name, name_plural, slug <<UQ>>
  name_en, name_plural_en
}
entity "breeds" as breeds {
  * id <<PK>>
  --
  * species_id <<FK>>
  name (UQ з species_id), name_en
}
entity "colors" as colors {
  * id <<PK>>
  --
  name <<UQ>>, name_en
}
entity "regions" as regions {
  * id <<PK>>
  --
  name <<UQ>>, name_en
}
entity "localities" as localities {
  * id <<PK>>
  --
  * region_id <<FK>>
  name (UQ з region_id), name_en
}
entity "users" as users {
  * id <<PK>>
  --
  name, email <<UQ>>, password (хеш)
  role: user | admin
  email_verified_at, phone, region_id <<FK>>
}
entity "animals" as animals {
  * id <<PK>>
  --
  * species_id, locality_id <<FK>>
  breed_id, color_id, created_by <<FK>>
  name, name_en, slug <<UQ>>, sex, birth_date
  is_sterilized, is_vaccinated
  story, behavior, adoption_terms (+ *_en)
  current_location (+ _en), source, status
  moderation_note, published_at,
  adopted_at, deleted_at
}
entity "animal_photos" as photos {
  * id <<PK>>
  --
  * animal_id <<FK>>
  path, thumb_path, alt, sort_order
}
entity "adoption_applications" as apps {
  * id <<PK>>
  --
  * animal_id, region_id <<FK>>
  user_id <<FK>>
  name, email, phone, social_url
  contact_channels (json), comment
  consent_at, status, admin_notes, ip_address
}
entity "application_status_changes" as changes {
  * id <<PK>>
  --
  * adoption_application_id <<FK>>
  user_id <<FK>>
  from_status, to_status, note, created_at
}
entity "favorites" as fav {
  * user_id, animal_id <<PK, FK>>
}
entity "post_categories" as cats {
  * id <<PK>>
  --
  name <<UQ>>, name_en, slug <<UQ>>
}
entity "posts" as posts {
  * id <<PK>>
  --
  * post_category_id <<FK>>
  author_id <<FK>>
  title, excerpt (+ *_en), slug <<UQ>>
  meta_title, meta_description (+ *_en)
  cover_path, blocks (jsonb, переклад
  усередині блоку), status, published_at
}
entity "shelter_settings" as settings {
  * id <<PK>>
  --
  name, tagline, address (+ *_en), phone,
  email, notification_email, *_url соцмереж
  help_text, default_adoption_terms (+ *_en)
  google_site_verification, google_analytics_id
}
entity "seo_pages" as seo {
  * id <<PK>>
  --
  key <<UQ>> (home, animals, species:cat, blog…)
  title, description, h1, text (+ *_en)
}
entity "donation_methods" as don {
  * id <<PK>>
  --
  type: monobank | requisites | paypal | link
  position, is_visible
  title, note (+ *_en)
  details (json: url, iban, recipient…)
}
species ||--o{ breeds
species ||--o{ animals
breeds |o--o{ animals
colors |o--o{ animals
regions ||--o{ localities
localities ||--o{ animals
users |o--o{ animals : created_by
animals ||--o{ photos
animals ||--o{ apps
regions ||--o{ apps
users |o--o{ apps
apps ||--o{ changes
users |o--o{ changes
users ||--o{ fav
animals ||--o{ fav
cats ||--o{ posts
users |o--o{ posts : author_id
regions |o--o{ users
@enduml
