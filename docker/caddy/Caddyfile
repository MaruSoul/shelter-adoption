# HTTPS для сайту: Caddy сам отримує й поновлює сертифікат Let's Encrypt для домену.
# Домен береться зі змінної SITE_DOMAIN у .env (див. compose.prod.yaml).
{$SITE_DOMAIN} {
	reverse_proxy web:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
